# Sepolia RPC (public or Alchemy/Infura)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Throwaway TESTNET-ONLY wallets. NEVER use a wallet holding real funds.
ORG_PRIVATE_KEY=0x_placeholder_org_owner
HR_PRIVATE_KEY=0x_placeholder_hr_delegate

# Org ENS name registered on ENSv2 Sepolia
ORG_ENS_NAME=kakunin-demo.eth

# Telegram bot (BotFather)
TELEGRAM_BOT_TOKEN=placeholder
TELEGRAM_BOT_USERNAME=KakuninxyzBot

# Secret an org admin sends as /subscribe <ADMIN_SECRET> to receive impersonation alerts in Telegram
ADMIN_SECRET=change-me

# Curvegrid MultiBaas
MULTIBAAS_DEPLOYMENT_URL=https://placeholder.multibaas.com
MULTIBAAS_API_KEY=placeholder

# P2 - Intercepta (free sandbox key: intercepta.io/ethglobal)
INTERCEPTA_API_KEY=placeholder

# Local-only: lets the /demo page revoke/reset with the throwaway keys above. NEVER enable on a public host.
KAKUNIN_DEMO_SIGNER=0

# x402 demo agent (throwaway). Fund with Base Sepolia USDC from faucet.circle.com
AGENT_PRIVATE_KEY=0x_placeholder_agent
# Base Sepolia receiving address of the real paid API (defaults to the org wallet)
X402_PAY_TO=

# Cloud (see docs/CLOUD.md): presenter-only demo actions, public agent demo, Telegram webhook secret, public URL
DEMO_ADMIN_TOKEN=
KAKUNIN_AGENT_PUBLIC=0
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=https://kakunin.xyz
# Upstash Redis (added automatically by the Vercel integration): KV_REST_API_URL / KV_REST_API_TOKEN
