{
  "name": "kakunin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "spike:wallets": "pnpm --filter @kakunin/scripts exec tsx gen-wallets.ts",
    "spike:ens": "pnpm --filter @kakunin/scripts exec tsx spike-ens.ts",
    "seed": "pnpm --filter @kakunin/scripts seed",
    "demo:revoke-bob": "pnpm --filter @kakunin/scripts revoke-member bob",
    "check": "pnpm --filter @kakunin/scripts check",
    "bot": "pnpm --filter @kakunin/bot dev",
    "web": "pnpm --filter @kakunin/web build && pnpm --filter @kakunin/web start",
    "rehearse": "pnpm --filter @kakunin/scripts rehearse",
    "paid": "pnpm --filter @kakunin/paid-api server",
    "agent": "pnpm --filter @kakunin/paid-api agent",
    "webhook:set": "pnpm --filter @kakunin/scripts exec tsx telegram-webhook.ts set",
    "webhook:delete": "pnpm --filter @kakunin/scripts exec tsx telegram-webhook.ts delete",
    "webhook:info": "pnpm --filter @kakunin/scripts exec tsx telegram-webhook.ts info",
    "cloud:check": "pnpm --filter @kakunin/scripts exec tsx cloud-check.ts",
    "vercel:env": "pnpm --filter @kakunin/scripts exec tsx vercel-env.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
